{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["build/**", "dist/**"]
    },
    "dev:local-servers": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": [
        "MCP_SERVER_URL",
        "MML_SERVER_URL",
        "WEB_WORLD_SERVER_URL",
        "VIEWER_SERVER_PORT",
        "MSQUARED_API_KEY"
      ]
    },
    "inspector": {
      "cache": false,
      "persistent": true
    },
    "dev:stdio:setup-config": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build", "dev:local-servers"]
    },
    "dev:stdio:watch": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build", "dev:stdio:setup-config"]
    },
    "dev:sse": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": ["MML_SERVER_URL", "WEB_WORLD_SERVER_URL", "MSQUARED_API_KEY"]
    },
    "dev:streamable-http": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": ["MML_SERVER_URL", "WEB_WORLD_SERVER_URL", "MSQUARED_API_KEY"]
    },
    "prod": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": ["MML_SERVER_URL", "WEB_WORLD_SERVER_URL", "MSQUARED_API_KEY"]
    },
    "frontend-app": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": ["MML_SERVER_URL", "WEB_WORLD_SERVER_URL", "MSQUARED_API_KEY"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "lint": {
      "outputs": [],
      "cache": false
    }
  }
}
