#!/bin/bash

# Development script that manages ngrok lifecycle with Next.js dev server
# Usage: ./dev-with-ngrok.sh

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Track if we started ngrok ourselves
NGROK_STARTED_BY_US=false
NGROK_PID=""
NEXT_PID=""

# Cleanup function
cleanup() {
    echo -e "\n${YELLOW}🧹 Cleaning up...${NC}"

    # Kill Next.js dev server if running
    if [ ! -z "$NEXT_PID" ]; then
        echo -e "${BLUE}🛑 Stopping Next.js dev server...${NC}"
        kill $NEXT_PID 2>/dev/null || true
        wait $NEXT_PID 2>/dev/null || true
    fi

    # Only kill ngrok if we started it
    if [ "$NGROK_STARTED_BY_US" = true ] && [ ! -z "$NGROK_PID" ]; then
        echo -e "${BLUE}🛑 Stopping ngrok...${NC}"
        kill "$NGROK_PID" 2>/dev/null || true
        wait "$NGROK_PID" 2>/dev/null || true
    fi

    echo -e "${GREEN}✅ Cleanup complete${NC}"
    exit 0
}

# Set up signal handlers
trap cleanup SIGINT SIGTERM EXIT

echo -e "${BLUE}🚀 Starting development environment with ngrok...${NC}"

# Check if ngrok is available
if ! command -v ngrok &>/dev/null; then
    echo -e "${RED}❌ ngrok is not installed or not in PATH${NC}"
    echo -e "${YELLOW}💡 Please install ngrok: https://ngrok.com/download${NC}"
    exit 1
fi

# Check if ngrok is already running
echo -e "${YELLOW}🔍 Checking if ngrok is running...${NC}"
if curl -s http://localhost:4040/api/tunnels >/dev/null 2>&1; then
    echo -e "${GREEN}✅ ngrok is already running${NC}"
else
    echo -e "${YELLOW}🌐 Starting ngrok...${NC}"
    # Temporarily show ngrok output for debugging
    ngrok http 3000 &
    NGROK_PID=$!
    NGROK_STARTED_BY_US=true

    # Wait for ngrok to start
    echo -e "${YELLOW}⏳ Waiting for ngrok to initialize...${NC}"
    for i in {1..30}; do
        if curl -s http://localhost:4040/api/tunnels >/dev/null 2>&1; then
            echo -e "${GREEN}✅ ngrok started successfully${NC}"
            break
        fi
        if [ "$i" -eq 30 ]; then
            echo -e "${RED}❌ ngrok failed to start within 30 seconds${NC}"
            exit 1
        fi
        sleep 1
    done
fi

# Update ngrok URL
echo -e "${YELLOW}🔗 Updating ngrok URL...${NC}"
./update-ngrok-url.sh

# Start Next.js dev server
echo -e "${YELLOW}🚀 Starting Next.js dev server...${NC}"
npm run dev &
NEXT_PID=$!

# Wait for Next.js to start
echo -e "${YELLOW}⏳ Waiting for Next.js to initialize...${NC}"
for i in {1..30}; do
    if curl -s http://localhost:3000 >/dev/null 2>&1; then
        echo -e "${GREEN}✅ Next.js dev server started successfully${NC}"
        break
    fi
    if [ "$i" -eq 30 ]; then
        echo -e "${YELLOW}⚠️  Next.js dev server taking longer than expected to start${NC}"
        break
    fi
    sleep 1
done

# Get and display the ngrok URL
NGROK_URL=$(curl -s http://localhost:4040/api/tunnels | grep -o '"public_url":"https://[^"]*"' | cut -d'"' -f4)

echo -e "\n${GREEN}🎉 Development environment is ready!${NC}"
echo -e "${BLUE}📱 Local:  http://localhost:3000${NC}"
echo -e "${BLUE}🌐 Public: ${NGROK_URL}${NC}"
echo -e "${BLUE}🔧 MCP API: ${NGROK_URL}/api/mcp${NC}"
echo -e "\n${YELLOW}Press Ctrl+C to stop all services${NC}\n"

# Wait for Next.js process to finish
wait $NEXT_PID
